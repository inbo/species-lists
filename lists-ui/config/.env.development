# Application API Endpoints
VITE_BASE_PATH=/poc/species-lists/
VITE_API_BASEURL=/api/v2/species-lists
VITE_API_GRAPHQL=/graphql
VITE_API_LIST_UPLOAD=/v2/upload
VITE_API_LIST_DOWNLOAD=/v2/download
VITE_API_LIST_INGEST=/v2/ingest
VITE_API_LIST_DELETE=/v2/delete
VITE_API_LIST_REMATCH=/v2/rematch
VITE_API_LIST_REINDEX=/v2/reindex
VITE_API_LIST_CONSTRAINTS=/v2/constraints
VITE_API_LIST_QID=/v2/speciesListQid

# Admin API Endpoints
VITE_API_ADMIN_REDINDEX=/admin/reindex
VITE_API_ADMIN_REMATCH=/admin/rematch
VITE_API_ADMIN_MIGRATE=/admin/migrate
VITE_API_ADMIN_MIGRATE_PROGRESS=/admin/migrate/progress
VITE_API_ADMIN_WIPE=/admin/wipe
VITE_API_ADMIN_REBOOT=/admin/reboot
VITE_API_ADMIN_INDEXES=/admin/indexes

# Authentication
VITE_AUTH_AUTHORITY=http://host.docker.internal:9999/default
VITE_AUTH_CLIENT_ID=vbp-branding
VITE_AUTH_REDIRECT_URI=http://localhost:8080/poc/species-lists/
VITE_AUTH_END_SESSION_URI=http://localhost:9999/default/logout
VITE_AUTH_SCOPE="openid profile ala/roles"
VITE_AUTH_JWT_ROLES=ala:roles
VITE_AUTH_JWT_USERID=sub
VITE_AUTH_JWT_ADMIN_ROLE=ADMIN
VITE_AUTH_JWT_EDITOR_ROLE=EDITOR
VITE_SIGNUP_URL=http://localhost:9999/default/login
VITE_OIDC_AUTH_SERVER=https://auth-dev.inbo.be/realms/vbp/protocol/openid-connect/auth
VITE_PROFILE_ROLES=ala:roles
VITE_PROFILE_USERID=sub
VITE_ADMIN_ROLE=ADMIN

# ALA Endpoints
VITE_ALA_HOME_PAGE=http://localhost:8080
VITE_ALA_USER_PROFILE=http://localhost:8080/my-profile.html
VITE_ALA_BIE_SPECIES=http://localhost:8080/bie-index
VITE_ALA_BIOCACHE_OCC_SEARCH=http://localhost:8080/biocache-hub/search
VITE_ALA_SPATIAL=http://localhost:8080/spatial-hub
VITE_ALA_COLLECTORY=http://localhost:8080/collectory
VITE_ALA_ICONIC_SPECIES_PAGE=https://ala.org.au/iconic-species
VITE_ALA_MESSAGES=https://www.ala.org.au/status.json
VITE_ALA_GLOBAL_ADMIN=https://admin.test.ala.org.au/banners

# Misc
VITE_LOCALE=nl-BE
VITE_APP_FRESHWIDGET_ID=6000005589
VITE_LEGACY_SKIN=true
VITE_SHOW_ACTIVE_FILTER_TAGS=false

# Analytics
VITE_APP_FATHOM_ID=QDWZORBB
